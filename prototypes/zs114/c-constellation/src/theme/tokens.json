  "font": {
    "display": "\"ZX Serif\", \"Source Han Serif SC\", \"Noto Serif SC\", \"Songti SC\", serif",
    "sans": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Segoe UI\", sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
  },
  "fontSize": {
    "2xs": "11px", "xs": "12px", "sm": "13px", "base": "14px", "md": "16px", "lg": "20px",
    "xl": "28px", "2xl": "40px", "display": "clamp(48px, 7.2vw, 104px)"
  },
  "lineHeight": { "tight": "1.15", "snug": "1.4", "base": "1.6", "loose": "1.8" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px" },
  "radius": { "1": "4px", "2": "8px", "3": "12px", "pill": "999px" },
