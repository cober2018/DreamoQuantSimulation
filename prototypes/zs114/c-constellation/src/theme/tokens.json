    "dark": {
      "1": "0 1px 0 hsl(0 0% 100% / 0.04) inset, 0 1px 2px hsl(224 60% 2% / 0.5)",
      "2": "0 1px 0 hsl(0 0% 100% / 0.05) inset, 0 12px 32px hsl(224 60% 2% / 0.55)",
      "glow": "0 0 0 1px hsl(40 66% 64% / 0.35), 0 0 24px hsl(40 66% 64% / 0.12)"
    },
    "light": {
      "1": "0 1px 2px hsl(222 40% 20% / 0.06)",
      "2": "0 2px 4px hsl(222 40% 20% / 0.04), 0 12px 32px hsl(222 40% 20% / 0.08)",
      "glow": "0 0 0 1px hsl(38 72% 44% / 0.4), 0 0 20px hsl(38 72% 44% / 0.1)"
    }
  },
  "motion": {
    "dur-1": "150ms", "dur-2": "200ms", "dur-3": "250ms", "dur-slow": "1200ms",
    "ease-out": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "ease-std": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
