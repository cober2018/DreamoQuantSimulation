# /etc/dk-insight/insight.env（root:dk-insight 0640）。只列变量名，值不进仓库。
INSIGHT_ENV=production
INSIGHT_DATA_MODE=live
INSIGHT_DB_PATH=/var/lib/dk-insight/insight.sqlite3
INSIGHT_ALLOWED_ORIGINS=https://dk.dreamotech.cn
INSIGHT_PUBLIC_PAGES=overview,participation,industries,themes,history,calendar
INSIGHT_REGISTRATION=
INSIGHT_UPSTREAM_BASE_URL=
INSIGHT_UPSTREAM_API_KEY=
INSIGHT_UPSTREAM_TIMEOUT=15
INSIGHT_CACHE_TTL=60
INSIGHT_JWT_SECRET=
# INSIGHT_JWT_SECRET_PREVIOUS=          轮换 JWT 密钥时临时放旧值
# INSIGHT_UPSTREAM_LEGACY_API_KEY=      全部页面走 public-* 时不需要
# INSIGHT_POLICY_REQUIRE_SECOND_APPROVER=
INSIGHT_WECHAT_APPID=
INSIGHT_WECHAT_SECRET=
# MCP 内部封闭测试（门禁 A 无结论前不对外）：=1 才开 /mcp 与账号页令牌；名单外只有管理员可用
# INSIGHT_MCP_ENABLED=
# INSIGHT_MCP_USERS=                    逗号分隔用户名
# 只在首次启动时设置，管理员改密后立即删除这两行并重启
INSIGHT_BOOTSTRAP_ADMIN_USER=
INSIGHT_BOOTSTRAP_ADMIN_PASSWORD=
# 生产禁止设置：INSIGHT_AUTH_MODE、INSIGHT_MP_MOCK_LOGIN、INSIGHT_ACCESS_TOKEN、INSIGHT_FIXTURE_DIR
