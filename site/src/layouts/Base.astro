---
// 全站外壳：SEO 元信息、OG 默认值、JSON-LD、主题（首帧前决定，避免闪烁）、跳转链接、页头页脚
import '../../../design-system/dist/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../site.config.mjs';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  crumbs?: { name: string; path: string }[];
}
const { title, description = SITE.description, ogType = 'website', noindex = false, jsonLd = [], crumbs } = Astro.props;
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.origin).href;
const og = new URL('/og.png', SITE.origin).href;
const graph: object[] = [
  { '@type': 'Organization', '@id': `${SITE.origin}/#org`, name: SITE.brand, url: SITE.origin },
  { '@type': 'WebSite', '@id': `${SITE.origin}/#site`, name: SITE.name, url: `${SITE.origin}/`, inLanguage: 'zh-CN', publisher: { '@id': `${SITE.origin}/#org` } },
  ...(crumbs?.length
    ? [{ '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, SITE.origin).href })) }]
    : []),
  ...jsonLd,
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/brand/zhishu-favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="知数星耀 博客" href="/blog/rss.xml" />
    <link rel="preload" href="/fonts/zx-serif.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // 先于首帧决定主题：URL ?theme= > 本地偏好 > 系统设置
      (function () {
        var q = new URLSearchParams(location.search).get('theme');
        var t = q === 'light' || q === 'dark' ? q : null;
        try { t = t || localStorage.getItem('zx-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site">
      <SiteHeader />
      <main id="main" tabindex="-1"><slot /></main>
      <SiteFooter />
    </div>
  </body>
</html>
<style>
  .site { min-height: 100vh; display: flex; flex-direction: column; background: var(--c-bg); }
  main { flex: 1; width: 100%; }
  main:focus { outline: none; }
</style>
