---
// 关注知数Talk 主理人：卡片数据只来自 data/social.json（ZS-115 §十）。卡片上不写扫码后看到的平台昵称或真实姓名。
import Base from '../layouts/Base.astro';
import PlatformMark from '../components/PlatformMark.astro';
import { SOCIAL } from '../lib/social';
const scanApp = (p: string) => (p === '公众号' ? '微信' : p);
---
<Base title="关注知数Talk 主理人" description="知数Talk 主理人在公众号、抖音、小红书分享市场数据的口径和读法。扫码即可关注；内容仅作数据与方法交流，不构成投资建议。">
  <div class="wrap page">
    <p class="eyebrow">公众号 · 抖音 · 小红书</p>
    <h1 class="page-title display">关注知数Talk 主理人</h1>
    <p class="page-lede">在公众号、抖音、小红书上分享市场数据的口径和读法。用对应 App 扫码即可关注；内容仅作数据与方法交流，不构成投资建议。</p>
    {SOCIAL.length ? (
      <ul class="cards">
        {SOCIAL.map((s) => (
          <li id={s.platform} class:list={['card', { draft: !s.ready }]}>
            <div class="hd">
              <PlatformMark platform={s.platform} />
              <div><h2 class="nm">{s.name}</h2><p class="pf">{s.platformName}</p></div>
            </div>
            <figure class="qr">
              {/* 码图放在白底容器里（暗色主题也是白底），不加滤镜、不做圆角裁切，否则可能扫不出 */}
              {s.qr ? (
                <div class="qr-box"><img src={s.qr} alt={s.qrAlt || `${s.name} ${s.platformName}二维码`} width="276" height="276" loading="lazy" decoding="async" /></div>
              ) : (
                <div class="qr-ph" role="img" aria-label={`${s.platformName}二维码待补充`}>二维码待补充</div>
              )}
              <figcaption>{s.qr ? `用${scanApp(s.platformName)} App 扫码` : '账号信息确认后放入'}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">公众号、抖音、小红书的账号确认后会放在这里。</p>
    )}
  </div>
</Base>
<style>
  .cards { margin-top: var(--s-7); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); }
  .card { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5); border: 1px solid var(--c-line); border-radius: var(--r-3); background: var(--c-surface); scroll-margin-top: var(--s-5); }
  .card.draft { border-style: dashed; }
  .hd { display: flex; align-items: center; gap: var(--s-3); }
  .nm { font-size: var(--fs-lg); font-weight: 600; line-height: 1.3; }
  .pf { font-size: var(--fs-xs); color: var(--c-ink-3); }
  .qr { display: flex; flex-direction: column; align-items: center; gap: var(--s-2); padding: var(--s-5) 0 var(--s-3); border-top: 1px solid var(--c-line); }
  .qr-box { width: min(300px, 100%); aspect-ratio: 1; padding: 12px; background: var(--c-qr-surface); border: 1px solid var(--c-line); border-radius: var(--r-2); }
  .qr-box img { width: 100%; height: 100%; object-fit: contain; }
  .qr-ph { width: 160px; height: 160px; display: grid; place-items: center; border: 1px dashed var(--c-line-strong); border-radius: var(--r-2); background: var(--c-surface-2); color: var(--c-ink-2); font-size: var(--fs-sm); }
  figcaption { font-size: var(--fs-xs); color: var(--c-ink-3); }
  .empty { margin-top: var(--s-6); color: var(--c-ink-2); }
  @media (max-width: 1099px) { .cards { grid-template-columns: minmax(0, 1fr); max-width: 420px; } }
</style>
