# live | fixture（fixture 含合成数据，production 环境禁止）
INSIGHT_DATA_MODE=live
INSIGHT_ENV=development
# DreamO 数据中台地址与只读 API Key（由数据中台管理员签发，仅存服务端）
INSIGHT_UPSTREAM_BASE_URL=http://127.0.0.1:8000
INSIGHT_UPSTREAM_API_KEY=
INSIGHT_UPSTREAM_TIMEOUT=15
INSIGHT_CACHE_TTL=60
# 设置后 /api/v1/*（health 除外）需 Bearer 令牌；前端开发代理会自动注入
INSIGHT_ACCESS_TOKEN=
